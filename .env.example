LIBRARY_CARD_NUMBER=
LIBRARY_PIN=
# HTTP auth: cloudflare-access, jwt, bearer or none. Inferred from the settings below when unset.
# AUTH_MODE=cloudflare-access

# cloudflare-access
# Zero Trust > Settings > Custom pages shows the team domain; the AUD tag is on the Access app's Overview tab.
CF_ACCESS_TEAM_DOMAIN=https://yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# Optional belt-and-braces on top of the Access policy (both JWT modes).
ALLOWED_EMAILS=you@example.com

# jwt: any proxy that forwards a signed JWT
# AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# AUTH_AUDIENCE=
# AUTH_ISSUER=
# AUTH_JWT_HEADER=Authorization

# bearer: shared secret for clients that can send headers (not claude.ai); e.g. openssl rand -hex 32
# AUTH_TOKEN=
