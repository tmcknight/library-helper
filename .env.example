# Copy to .env and fill in. See README "Remote deployment" for what each auth mode needs.

# Library card. Leave both blank for catalogue-only use.
LIBRARY_CARD_NUMBER=
LIBRARY_PIN=

# How /mcp requests are authenticated: cloudflare-access, jwt, bearer or none.
# Pick one, then fill in only that mode's section below.
AUTH_MODE=cloudflare-access

# --- cloudflare-access: claude.ai via a Cloudflare Tunnel + Access app ---
# Team domain: Zero Trust > Settings > Custom pages, e.g. https://yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Audience (AUD) tag: on the Access application's Overview tab.
CF_ACCESS_AUD=

# --- jwt: any other proxy that forwards a signed JWT (Pomerium, Google IAP, ...) ---
# AUTH_JWKS_URL=
# AUTH_AUDIENCE=
# AUTH_ISSUER=
# AUTH_JWT_HEADER=

# --- bearer: shared secret for Claude Code and similar clients (not claude.ai) ---
# Generate with: openssl rand -hex 32
# AUTH_TOKEN=

# Optional, cloudflare-access and jwt only: comma-separated emails allowed in.
# ALLOWED_EMAILS=you@example.com
